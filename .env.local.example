# ============================================================================
# SRVP — Student Request & Payment Portal
# Environment configuration
# ============================================================================
# Copy this file to `.env.local` and fill in the values. Never commit
# `.env.local` or `.env` to source control — they contain secrets.
#
# On Vercel, do NOT create this file. Instead, add each variable via the
# Vercel dashboard (Project → Settings → Environment Variables) so they are
# injected securely at runtime.
# ============================================================================

# ---------------------------------------------------------------- App ------
# "development" shows full PDO errors on screen. Set to "production" online.
APP_ENV=development

# Full public URL of the install — REQUIRED on Vercel / behind a proxy.
# Trailing slash is optional. Examples:
#   Local XAMPP: APP_URL=http://localhost/student-e-request
#   Vercel:      APP_URL=https://your-project-name.vercel.app
#   Custom:      APP_URL=https://request.yourschool.edu
APP_URL=

# IANA timezone name for the school. See https://php.net/manual/en/timezones.php
APP_TIMEZONE=Asia/Manila

# --------------------------------------------------------- Database --------
# MySQL / MariaDB connection.
#
# On Vercel there is NO built-in MySQL. Provision an external compatible DB:
#   - PlanetScale (serverless MySQL, free tier)  — set DB_SSL=true
#   - Railway MySQL                              — set DB_SSL=true
#   - Aiven MySQL / MariaDB                      — set DB_SSL=true
#   - Supabase (Postgres NOT supported — use MySQL-compatible provider)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student-req
DB_USER=root
DB_PASS=

# Set to "true" for managed cloud databases that require TLS (all of the
# providers above). Leave as "false" for local XAMPP.
DB_SSL=false

# ------------------------------------------------------------ Email --------
# How email is delivered.
#   "log"  — no real emails are sent; everything is appended to
#            mail_outbox/mail.log — safe for demos / local dev.
#   "smtp" — real delivery via the server below.
MAIL_MODE=log

MAIL_FROM=no-reply@srvp.test
MAIL_FROM_NAME="SRVP Student Portal"
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ------------------------------------------------------------ Clerk --------
# Clerk.com hosted authentication — replaces the native PHP login/register
# forms with hosted sign-in/sign-up pages, social providers, MFA, magic
# links, etc.
#
# STEPS:
#   1. Create a free account at https://dashboard.clerk.com
#   2. Add a new application. Enable Email + any social providers you want.
#   3. In Clerk Dashboard → API Keys, copy Publishable + Secret keys below.
#   4. Set APP_URL to your live public URL — Clerk needs this for redirects.
#   5. In Clerk Dashboard → Routes, set "After sign-in URL" and
#      "After sign-up URL" to your APP_URL + /login.php (e.g.
#      https://srvp.vercel.app/login.php). Clerk will redirect here with a
#      __session JWT; login.php will verify it and create or update the
#      matching student/cashier/registrar account.
#   6. IMPORTANT: In Clerk → User Metadata, add a public metadata field
#      "school_id" or set it via the Dashboard per user. The format is:
#          2024-10001           → Student (YYYY-NNNNN)
#          CSH-00001            → Cashier
#          REG-00001            → Registrar
#      If a user has no school_id in their public metadata the first time
#      they log in, the app will prompt them to enter one on a bridge page,
#      OR you can set a default by making the first sign-up email match the
#      seed accounts (registrar.admin@gmail.com → Registrar etc.).
#
# Leave CLERK_ENABLED=false to keep the native login/register forms.

CLERK_ENABLED=false

# Get these from https://dashboard.clerk.com/ → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auto-derived from publishable key if empty:
#   pk_test_abc123 → https://clean-otter-123.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Optional custom URLs (if using Clerk Hosted Pages + custom domain or
# Account Portal URLs). If blank, the app builds them from the publishable
# key's frontend API automatically.
CLERK_SIGNIN_URL=
CLERK_SIGNUP_URL=

# Where Clerk sends users AFTER they sign in / sign out via the Account
# Portal page. Generally you want these to point at your app.
CLERK_AFTER_SIGNIN_URL=
CLERK_AFTER_SIGNOUT_URL=

# --- SMS notifications ------------------------------------------------------
# log = store messages only (no real SMS). semaphore = send via Semaphore PH.
# textbee = free, sends from your own Android phone (https://textbee.dev).
SMS_MODE=log
SMS_API_KEY=
SMS_SENDER_NAME=SRVP
